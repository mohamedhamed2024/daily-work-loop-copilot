# Daily Work Loop Copilot — environment template
# Copy to `.env` and fill in values. Never commit `.env`.
#
#   cp .env.example .env
#
# Set INTEGRATION_STACK and install the matching Cursor plugin:
#   atlassian → Atlassian plugin (OAuth) — Jira + Bitbucket
#   github    → GitHub plugin (OAuth) — Issues + PRs

# --- Stack (required) ---

INTEGRATION_STACK=atlassian
# INTEGRATION_STACK=github

# --- Atlassian stack (when INTEGRATION_STACK=atlassian) ---

JIRA_PROJECT_KEYS=PROJ,ENG
BITBUCKET_WORKSPACE=my-workspace
BITBUCKET_REPO_SLUG=
JIRA_KEY_PATTERN=[A-Z][A-Z0-9]+-\d+
# ATLASSIAN_SITE_URL=https://your-org.atlassian.net

# --- GitHub stack (when INTEGRATION_STACK=github) ---

# GITHUB_OWNER=my-org
# GITHUB_REPO=my-service
# GITHUB_ISSUE_LINK_PATTERN=

# --- Shared ---

STALE_REVIEW_DAYS=2

# --- Write approval (local hook testing only) ---

# DAILY_LOOP_JIRA_WRITE_APPROVED=0
